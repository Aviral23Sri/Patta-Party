# Copy to .env.local (git-ignored) and fill in as needed.
# NOTE: every VITE_* value is compiled into the client bundle and is PUBLIC.
# Use short-lived or usage-restricted TURN credentials.

# ── TURN relay (only needed on strict networks: corporate Wi-Fi, some
#    mobile carriers, symmetric NAT). Comma-separated URLs.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ── Self-hosted PeerJS signalling server (optional).
#    Leave VITE_PEER_HOST empty to use the free public server (0.peerjs.com).
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
